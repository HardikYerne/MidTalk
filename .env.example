NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://platform:platform_dev_password@localhost:27017/platform?authSource=admin&replicaSet=rs0
MONGODB_DB=platform
REDIS_URL=redis://:redis_dev_password@localhost:6379
JWT_SECRET=development-only-change-this-secret-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_MAX=100
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=platform_minio
MINIO_ROOT_PASSWORD=replace_this_local_password
MINIO_BUCKET=platform-files
PUBLIC_APP_URL=http://localhost:3000
COOKIE_SECURE=false

# LiveKit SFU (meetings). Obtain credentials from your LiveKit deployment.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret # LiveKit --dev only; use a strong secret outside local development

# OpenAI-compatible LLM endpoint for consented meeting summaries. Disabled until configured.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Yjs collaboration service
YJS_PORT=4001
YJS_JWT_SECRET= # leave empty to verify API JWTs with JWT_SECRET, or configure the same signing secret

# OpenAI-compatible audio transcription endpoint (consent required per participant)
STT_ENABLED=false
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
